FROM python:3.11-slim

WORKDIR /srv
COPY packages/contracts /srv/packages/contracts
COPY apps/ai-engine /srv/apps/ai-engine
RUN pip install --no-cache-dir -e /srv/packages/contracts -e "/srv/apps/ai-engine[postgres]"

WORKDIR /srv/apps/ai-engine
EXPOSE 8001
CMD ["uvicorn", "engine.main:app", "--host", "0.0.0.0", "--port", "8001"]
