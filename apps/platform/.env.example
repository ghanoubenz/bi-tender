# Copy this file to .env and it works as-is for local development:
#     cp .env.example .env
# Production values are set in the hosting dashboard, never in this file.

# Any random string works locally. For production: openssl rand -hex 32
PAYLOAD_SECRET=local-dev-secret-not-for-production

# SQLite locally — no Docker or database server needed.
# Staging/production use Postgres instead, e.g.
#   DATABASE_URI=postgres://user:password@host/dbname
DATABASE_URI=file:./tender-platform.db

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Tender AI Engine (Phase 2). The platform runs fine without it.
ENGINE_BASE_URL=http://localhost:8001
ENGINE_SERVICE_TOKEN=dev-service-token
