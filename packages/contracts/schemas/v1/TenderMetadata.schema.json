{
  "$defs": {
    "EvidenceReference": {
      "description": "Pointer from a fact to the exact place in a source document it came from.",
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filename"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Heading trail, e.g. 'Section 7 > 7.3 Qualification'",
          "title": "Section Path"
        },
        "clause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause number, e.g. '7.3.2'",
          "title": "Clause"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the parsed DocumentBlock",
          "title": "Block Id"
        },
        "quote": {
          "description": "Verbatim quote from the source supporting the fact",
          "title": "Quote",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/ExtractionMethod",
          "default": "llm"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "verified": {
          "default": false,
          "description": "True if the quote was substring-validated against the source block",
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "document_id",
        "quote",
        "confidence"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ExtractionMethod": {
      "enum": [
        "llm",
        "rule",
        "ocr_llm",
        "human"
      ],
      "title": "ExtractionMethod",
      "type": "string"
    },
    "MetadataField": {
      "description": "A single Layer-1 metadata fact. Unknown => value None and needs_review True.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "title": "MetadataField",
      "type": "object"
    }
  },
  "description": "Layer-1 tender metadata. Every field is optional and evidence-backed.",
  "properties": {
    "client": {
      "$ref": "#/$defs/MetadataField"
    },
    "project_title": {
      "$ref": "#/$defs/MetadataField"
    },
    "tender_reference": {
      "$ref": "#/$defs/MetadataField"
    },
    "country": {
      "$ref": "#/$defs/MetadataField"
    },
    "submission_deadline": {
      "$ref": "#/$defs/MetadataField"
    },
    "scope_summary": {
      "$ref": "#/$defs/MetadataField"
    },
    "bid_validity": {
      "$ref": "#/$defs/MetadataField"
    },
    "bid_bond": {
      "$ref": "#/$defs/MetadataField"
    },
    "submission_method": {
      "$ref": "#/$defs/MetadataField"
    },
    "contact": {
      "$ref": "#/$defs/MetadataField"
    }
  },
  "title": "TenderMetadata",
  "type": "object"
}
