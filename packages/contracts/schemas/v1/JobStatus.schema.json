{
  "$defs": {
    "JobState": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed"
      ],
      "title": "JobState",
      "type": "string"
    },
    "JobType": {
      "enum": [
        "ingest",
        "extract_metadata",
        "extract_requirements",
        "compliance",
        "score"
      ],
      "title": "JobType",
      "type": "string"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/JobType"
    },
    "state": {
      "$ref": "#/$defs/JobState"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "progress": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Progress",
      "type": "number"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Contract payload for the job type, present when succeeded",
      "title": "Result"
    }
  },
  "required": [
    "id",
    "type",
    "state",
    "tenant_id"
  ],
  "title": "JobStatus",
  "type": "object"
}
